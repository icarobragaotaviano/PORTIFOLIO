{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm test && node scripts/build.mjs --base /",
  "outputDirectory": "dist",
  "functions": {
    "api/portfolio.js": { "includeFiles": "{src/**,server/portfolio-*.js,public/portfolio.js,public/content-schema.js}", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/portfolio?action=home" },
    { "source": "/index.html", "destination": "/api/portfolio?action=home" },
    { "source": "/studio", "destination": "/studio/index.html" },
    { "source": "/studio/", "destination": "/studio/index.html" },
    { "source": "/admin", "destination": "/studio/index.html" },
    { "source": "/admin/", "destination": "/studio/index.html" },
    { "source": "/projetos/:slug/", "destination": "/api/portfolio?action=page&slug=:slug" },
    { "source": "/projetos/:slug/index.html", "destination": "/api/portfolio?action=page&slug=:slug" },
    { "source": "/projetos/:slug", "destination": "/api/portfolio?action=page&slug=:slug" }
  ]
}
